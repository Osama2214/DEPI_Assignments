@LibraryApi_HostAddress = http://localhost:5087
@token = PASTE_LOGIN_TOKEN_HERE

###

POST {{LibraryApi_HostAddress}}/api/account/register
Content-Type: application/json

{
  "email": "student@example.com",
  "password": "Example!Password123"
}

###

POST {{LibraryApi_HostAddress}}/api/account/login
Content-Type: application/json

{
  "email": "student@example.com",
  "password": "Example!Password123"
}

###

GET {{LibraryApi_HostAddress}}/api/authors
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{LibraryApi_HostAddress}}/api/authors?pageNumber=1&pageSize=2&searchTerm=Naguib
Authorization: Bearer {{token}}
Accept: application/json

###

POST {{LibraryApi_HostAddress}}/api/authors
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "New Author",
  "birthDate": "1980-01-01"
}

###

GET {{LibraryApi_HostAddress}}/api/books
Accept: application/json

###

POST {{LibraryApi_HostAddress}}/api/books
Content-Type: application/json

{
  "title": "Palace Walk",
  "isbn": "9780307947109",
  "authorId": 1
}

###

GET {{LibraryApi_HostAddress}}/api/borrowers
Accept: application/json

###

POST {{LibraryApi_HostAddress}}/api/borrowers
Content-Type: application/json

{
  "name": "Ahmed Ali",
  "membershipDate": "2026-10-20"
}

###

GET {{LibraryApi_HostAddress}}/api/loans
Accept: application/json

###

POST {{LibraryApi_HostAddress}}/api/loans
Content-Type: application/json

{
  "bookId": 1,
  "borrowerId": 1,
  "loanDate": "2026-10-20",
  "returnDate": null
}
